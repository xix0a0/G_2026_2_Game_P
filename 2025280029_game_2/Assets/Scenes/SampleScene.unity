  m_Script: {fileID: 11500000, guid: 514dd9ea9ff73f94188a9b0867226b39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - Speaker: "\uBC84\uC12F\uC544\uC800\uC528"
    text: "\uBB50\uC57C? \uC54C\uBC14 \uC9C0\uC6D0\uC774\uB0D0?"
  - Speaker: "\uB098"
    text: "\uC544\uB2CC\uB370\uC694"
  - Speaker: "\uBC84\uC12F\uC544\uC800\uC528"
    text: "\uADF8\uB7FC \uC65C \uC5EC\uAE30\uC11C \uC54C\uC9F1\uAC70\uB824"
  - Speaker: "\uB098"
    text: '?'
  - Speaker: "\uBC84\uC12F\uC544\uC800\uC528"
    text: "\uB3C4\uB451\uB188\uC774\uB85C\uAD6C\uB098!!!"
  - Speaker: "\uB098"
    text: "(\uBE68\uB9AC \uC774 \uC790\uB9AC\uB97C \uBC97\uC5B4\uB098\uC57C\uB420
      \uAC83 \uAC19\uB2E4.)"
  prompt: {fileID: 1018319070}
  dialogueBox: {fileID: 2064006896}
